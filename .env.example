# LLM API Key（支持任何 OpenAI 兼容的服务）
# 智谱 GLM: 从 https://open.bigmodel.cn/apikey/platform 获取（推荐；详见 README「模型推荐」）
# DeepSeek: 从 https://platform.deepseek.com 获取
# ModelScope: 从 https://modelscope.cn/my/access/token 获取
LLM_API_KEY=your_api_key_here

# LLM API 基础地址（默认使用智谱 GLM 的 OpenAI 兼容端点）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# LLM 模型名称
LLM_MODEL_NAME=glm-5.3-flash

# 备选配置示例（智谱 GLM 更快版本，试用额度与价格见 README）
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-5.3-flashx

# 备选配置示例（DeepSeek 官方 API：速度快、价格低，适合发布委托）
# 官方目前只有 deepseek-flash 这一个 flash 模型；纯文本，不带立绘
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-flash

# 备选配置示例（ModelScope 魔搭，仅适合试聊，工具调用支持因模型而异）
# LLM_API_BASE=https://api-inference.modelscope.cn/v1
# LLM_MODEL_NAME=Qwen/Qwen3.5-397B-A17B

# 备选配置示例（Google Gemini，需代理）
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL_NAME=gemini-3.8-flash

# 备选配置示例（Kimi / Moonshot）
# LLM_API_BASE=https://api.moonshot.cn/v1
# LLM_MODEL_NAME=kimi-k2.8

# 本地 Ollama（OpenAI 兼容；OpenAI 客户端要求非空 api_key，可填 ollama）
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL_NAME=qwen2.5:7b
# LLM_API_KEY=ollama

# LLM 代理（仅作用于 LLM 请求，不改进程环境变量；也可在前端设置页按会话配置）
# LLM_PROXY_URL=http://127.0.0.1:7890

# 游戏资源根目录（包含 data/、docs/story/ 等；默认自动探测同级 resources/ 或 CrazyFlashNight/）
# CFN_RESOURCES_DIR=E:\path\to\CrazyFlashNight

# 游戏项目根目录（对话立绘 manifest 所在；通常与游戏资源根相同）
# CFN_GAME_PROJECT_DIR=E:\path\to\CrazyFlashNight

# 调试开关（在 stderr 打印每轮 prompt/工具调用完整内容；排障用）
# CFN_AGENT_DEBUG_LLM=1
# CFN_AGENT_DEBUG_LATENCY=1
